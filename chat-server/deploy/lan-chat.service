[Unit]
Description=LAN Chat Server
After=network.target postgresql.service

[Service]
Type=simple
User=lan-chat
Group=lan-chat
WorkingDirectory=/opt/lan-chat/chat-server
EnvironmentFile=/etc/lan-chat/lan-chat.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
